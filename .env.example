NODE_ENV=development
PORT=5000

# Use a MySQL account with permission to create databases and tables.
# The database will be created automatically on first startup.
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/visa_slot_agency"

JWT_SECRET="replace_with_a_random_secret_at_least_32_characters"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required to accept booking-site passwords. Keep this key private and stable; rotating it makes saved credentials unreadable.
BOOKING_CREDENTIAL_KEY="replace_with_64_hex_characters"
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
